# QKD-keyed encryptor appliance for a single k3s node. Source template: scripts/build.py turns it into encryptor.yaml.
# One Pod (hostNetwork) with three consumers of ETSI GS QKD 014 keys, fed by qkd-agent:
#   strongswan : IPsec IKEv2 tunnels, QKD key injected as RFC 8784 PPK
#   stunnel    : TLS 1.3 tunnels (HTTPS, any TCP), QKD key as external PSK
#   qkd-agent  : KME client + peer API; also rotates SSH key pairs (written under /var/lib/encryptor/ssh)
# Site-specific Secret/ConfigMap (site, site-secrets) are NOT in this file: Day 0 creates them (see README.md).
apiVersion: v1
kind: Namespace
metadata:
  name: encryptor
---
apiVersion: apps/v1
kind: Deployment
metadata: { name: encryptor, namespace: encryptor }
spec:
  replicas: 1
  strategy: { type: Recreate }
  selector: { matchLabels: { app: encryptor } }
  template:
    metadata: { labels: { app: encryptor } }
    spec:
      hostNetwork: true
      dnsPolicy: ClusterFirstWithHostNet
      containers:
        - name: strongswan
          image: ghcr.io/equinix-svc/svc-encryptor/strongswan:0.1.0
          securityContext: { capabilities: { add: [NET_ADMIN, NET_RAW, NET_BIND_SERVICE] } }
          volumeMounts:
            - { name: swanctl-main, mountPath: /etc/swanctl/swanctl.conf, subPath: swanctl.conf, readOnly: true }
            - { name: swanctl-conf-d, mountPath: /etc/swanctl/conf.d }
          resources: { requests: { cpu: 50m, memory: 64Mi }, limits: { memory: 256Mi } }
        - name: stunnel
          image: ghcr.io/equinix-svc/svc-encryptor/stunnel:0.1.0
          securityContext: { capabilities: { add: [NET_BIND_SERVICE] } }
          volumeMounts:
            - { name: site, mountPath: /etc/stunnel/stunnel.conf, subPath: stunnel.conf, readOnly: true }
            - { name: psk, mountPath: /psk, readOnly: true }
          resources: { requests: { cpu: 50m, memory: 32Mi }, limits: { memory: 256Mi } }
        - name: qkd-agent
          image: ghcr.io/equinix-svc/svc-encryptor/qkd-agent:0.1.0
          securityContext: { runAsUser: 0 }    # writes files shared with the root-owned containers above
          ports: [{ containerPort: 8444, hostPort: 8444 }]
          livenessProbe: { tcpSocket: { port: 8444 }, periodSeconds: 30 }
          volumeMounts:
            - { name: site, mountPath: /etc/qkd/config.json, subPath: config.json, readOnly: true }
            - { name: site-secrets, mountPath: /etc/qkd/tls, readOnly: true }
            - { name: swanctl-conf-d, mountPath: /swanctl/conf.d }
            - { name: psk, mountPath: /psk }
            - { name: ssh, mountPath: /ssh }
          resources: { requests: { cpu: 20m, memory: 48Mi }, limits: { memory: 128Mi } }
      volumes:
        - { name: site, configMap: { name: site } }
        - { name: site-secrets, secret: { secretName: site-secrets, defaultMode: 0400 } }
        - name: swanctl-main
          secret: { secretName: site-secrets, items: [{ key: swanctl.conf, path: swanctl.conf }], defaultMode: 0400 }
        - { name: swanctl-conf-d, emptyDir: { medium: Memory } }     # QKD keys stay in RAM, never on disk
        - { name: psk, emptyDir: { medium: Memory } }
        - { name: ssh, hostPath: { path: /var/lib/encryptor/ssh, type: DirectoryOrCreate } }
